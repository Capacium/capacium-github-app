# Capacium GitHub App — Environment Configuration
# Copy to .env.production and fill in values

# GitHub App credentials (from GitHub Settings → Developer settings → GitHub Apps)
GITHUB_WEBHOOK_SECRET=your-webhook-secret-here
GITHUB_APP_ID=123456

# Path to GitHub App private key PEM file
GITHUB_PRIVATE_KEY_PATH=/etc/capacium/keys/app-private-key.pem

# Capacium Exchange API endpoint
EXCHANGE_API_URL=https://api.capacium.xyz/v2

# Server configuration
PORT=8080
HOST=0.0.0.0
